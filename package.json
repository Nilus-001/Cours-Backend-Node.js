{
  "name": "backend-node",
  "version": "1.0.0",
  "description": "Nodejs express app",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "tsx --env-file=.env --tsconfig tsconfig.json src/server.ts",
    "dev": "tsx watch --env-file=.env --tsconfig tsconfig.json src/server.ts",
    "db:schema": "tsx --env-file=.env src/core/database/run-sql.ts src/core/database/schema.sql",
    "db:seed": "tsx --env-file=.env src/core/database/run-sql.ts src/core/database/seeders/01_catalogue.seed.sql src/core/database/seeders/02_users.seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "logging": "^4.2.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "nodemon": "^3.1.14",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
